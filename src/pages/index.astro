---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import Carimbo from "../components/Carimbo.astro";
import Bilhete from "../components/Bilhete.astro";
import Lettering from "../assets/brand/criar-comunicar-inovar.svg";
import Masthead from "../assets/brand/true.svg";
import {
  clientes,
  contato,
  crencas,
  depoimentos,
  fichaTecnica,
  instagramLink,
  metodo,
  msgOrcamento,
  nestaEdicao,
  servicos,
  whatsappLink,
} from "../data/site";

import capa from "../assets/fotos/tiphany-capa.png";
import carta from "../assets/fotos/tiphany-carta.jpg";
import celular from "../assets/fotos/tiphany-celular.jpg";
import estudio from "../assets/fotos/tiphany-estudio.jpg";
import corpo from "../assets/fotos/tiphany-corpo.jpg";
import bast2 from "../assets/fotos/bastidores-2.jpg";
import bast1 from "../assets/fotos/bastidores-1.jpg";
import bast3 from "../assets/fotos/bastidores-3.jpg";
import digital from "../assets/fotos/tiphany-digital.jpg";
import ecobag from "../assets/universo/ecobag.jpg";
import modelo from "../assets/fotos/modelo.jpg";
import camiseta from "../assets/universo/camiseta.jpg";
import canecas from "../assets/universo/canecas.jpg";
import necessaire from "../assets/universo/necessaire.jpg";
import garrafa from "../assets/universo/garrafa.jpg";

const faixa = ["Criar", "Comunicar", "Inovar", "Estratégia", "Conteúdo", "Produção"];

const tiraBastidores = [
  { src: estudio, alt: "Tiphany no estúdio, entre um take e outro", marca: true },
  { src: bast2, alt: "Ensaio teen com direção da True" },
  { src: bast1, alt: "Captação de foto com celular durante shooting infantil" },
  { src: modelo, alt: "Retrato para mídia kit", marca: true },
  { src: corpo, alt: "Ensaio de posicionamento pessoal" },
  { src: bast3, alt: "Ajuste de figurino nos bastidores" },
];
const tiraIdentidade = [
  { src: camiseta, alt: "Camisetas da equipe com o lettering Criar, Comunicar, Inovar" },
  { src: canecas, alt: "Canecas com o logo True Marketing", marca: true },
  { src: necessaire, alt: "Nécessaire personalizada para clientes" },
  { src: digital, alt: "Tiphany com tablet e celular" },
  { src: garrafa, alt: "Garrafa com o logo True Marketing" },
  { src: ecobag, alt: "Ecobag com o logo True Marketing" },
];

// quebra o depoimento em balões de mensagem (até ~2 frases cada)
const baloes = (texto: string) => {
  const frases = texto.match(/[^.!?]+[.!?]+["”]?/g) ?? [texto];
  const out: string[] = [];
  for (const f of frases.map((x) => x.trim())) {
    const ult = out[out.length - 1];
    if (ult && ult.length + f.length < 150) out[out.length - 1] = `${ult} ${f}`;
    else out.push(f);
  }
  return out;
};
const respostas = ["Que alegria ler isso! Seguimos juntas 🤍", "Você merece cada oportunidade! ✨", "A gente que agradece pela confiança 🤍"];
const iniciais = (nome: string) => nome.split(" ").map((p) => p[0]).join("").slice(0, 2).toUpperCase();
---

<Layout>
  <Header />

  <main id="conteudo">
    <!-- ══════════════ CAPA ══════════════ -->
    <section id="capa" class="relative isolate flex min-h-[max(40rem,100svh)] flex-col baixa:min-h-[max(36rem,100svh)] overflow-hidden bg-vinho text-creme">
      <div class="grao pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>

      <!-- título da revista, atrás da Tiphany -->
      <div class="relative z-0 mx-auto mt-[5.5rem] w-[min(100%-2rem,calc(100svh*1.1),84rem)] baixa:mt-[4.75rem] baixa:w-[min(100%-2rem,calc(100svh*0.9))]">
        <Masthead class="capa-titulo block h-auto w-full text-creme" aria-hidden="true" />
        <p class="eyebrow mt-3 flex justify-between text-[0.62rem] text-rosa-claro sm:text-[0.7rem]">
          <span>Nº 01 · Fortaleza</span><span>Edição 2026</span>
        </p>
      </div>

      <!-- capa -->
      <div class="capa-foto absolute bottom-0 left-1/2 z-10 h-[74%] -translate-x-[50%] sm:h-[80%] lg:h-[86%]">
        <Image
          src={capa}
          alt="Tiphany, fundadora da True Marketing, sorrindo em ensaio de estúdio"
          widths={[480, 720]}
          sizes="(min-width: 1024px) 560px, 80vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-auto max-w-none object-contain object-bottom drop-shadow-[0_30px_40px_rgb(40_0_10/0.35)]"
        />
      </div>

      <!-- chamadas de capa -->
      <div class="relative z-20 mx-auto flex w-full max-w-[90rem] flex-1 items-end px-5 pb-10 pt-16 sm:px-8 sm:pb-14 lg:pb-20 lg:pt-20 baixa:pb-8 baixa:pt-10 lg:baixa:pb-20 lg:baixa:pt-8">
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-vinho via-vinho/70 to-transparent lg:hidden" aria-hidden="true"></div>

        <div class="relative w-full lg:grid lg:grid-cols-12 lg:items-start">
          <div class="lg:col-span-4">
            <p class="eyebrow text-rosa-claro">Marketing para marcas de moda</p>
            <h1 class="display mt-4 text-[clamp(2.5rem,4.6vw,4.2rem)] baixa:mt-3 baixa:text-[clamp(2.3rem,3.8vw,3.3rem)]">
              Marca forte<br />tem <em class="text-rosa-claro">propósito.</em>
            </h1>
            <p class="mt-5 max-w-xs text-[0.95rem] leading-relaxed text-creme/80 baixa:mt-3 baixa:text-sm">
              Estratégia, conteúdo e produção para marcas que querem ser lembradas, não só vistas.
            </p>
            <a href={whatsappLink(msgOrcamento)} target="_blank" rel="noopener" class="btn-creme pointer-events-auto mt-7 baixa:mt-5 baixa:py-3">
              Quero ser capa <span aria-hidden="true">→</span>
            </a>
          </div>

          <nav aria-label="Nesta edição" class="hidden lg:col-span-3 lg:col-start-10 lg:block">
            <p class="eyebrow border-b border-creme/30 pb-3 text-rosa-claro">Nesta edição</p>
            <ol>
              {
                nestaEdicao.map((c) => (
                  <li>
                    <a href={c.href} class="group flex items-baseline gap-4 border-b border-creme/15 py-2.5 transition-colors baixa:py-1.5 hover:text-rosa-claro">
                      <span class="eyebrow shrink-0 text-creme/50 group-hover:text-rosa-claro">p.{c.pagina}</span>
                      <span class="font-display text-[1.05rem] leading-tight">{c.titulo}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </div>
      </div>
    </section>

    <!-- ══════════════ FAIXA ══════════════ -->
    <div class="bolinhas overflow-hidden border-y border-vinho/20 bg-rosa-claro py-5 text-vinho" aria-hidden="true">
      <div class="flex w-max animate-marquee items-center gap-8 whitespace-nowrap">
        {
          [0, 1, 2, 3].map(() =>
            faixa.map((p, i) => (
              <span class="flex items-center gap-8">
                <span class:list={["font-display text-3xl uppercase sm:text-4xl", i % 2 && "italic normal-case"]}>{p}</span>
                <span class="text-xl">✦</span>
              </span>
            )),
          )
        }
      </div>
    </div>

    <!-- ══════════════ p.03 VERDADES ══════════════ -->
    <section id="verdades" class="relative overflow-hidden bg-creme py-24 sm:py-32">
      <div class="mx-auto grid max-w-[90rem] items-center gap-20 px-5 sm:px-8 lg:grid-cols-12 lg:gap-10">
        <!-- manifesto -->
        <div class="lg:col-span-6">
          <p class="eyebrow text-vinho" data-reveal>p. 03 — Manifesto</p>
          <h2 class="display mt-6 text-[clamp(2.8rem,5.2vw,4.8rem)]" data-reveal>
            Ser social media não é <em class="text-vinho">só fazer um post.</em>
          </h2>
          <p class="mt-7 max-w-md text-lg leading-relaxed text-tinta/70" data-reveal>
            Marca se constrói com visão, constância e uma comunicação que tem a cara de quem você é. O resto é barulho no feed.
          </p>

          <div class="mt-14 max-w-lg" data-reveal>
            <ul class="border-t border-tinta/12">
              {
                crencas.map((c) => (
                  <li class="border-b border-tinta/12 py-4">
                    <span class="font-display text-[clamp(1.4rem,2.1vw,1.85rem)] leading-tight">
                      {c[0]} <em class="text-vinho">{c[1]}</em>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- colagem (celular) -->
        <div class="-mx-5 mt-6 sm:hidden" aria-label="Verdades cruéis demais sobre marketing">
          <div class="bolinhas-creme relative bg-vinho px-5 pb-10">
            <div class="flex items-start justify-between">
              <figure class="relative -mt-8 w-[54%] -rotate-[6deg] bg-papel p-2.5 pb-10 shadow-[0_20px_40px_-18px_rgb(20_0_5/0.6)]" data-reveal>
                <span class="absolute -top-3 left-1/2 h-5 w-16 -translate-x-1/2 rotate-[4deg] bg-rosa-claro/80" aria-hidden="true"></span>
                <Image src={celular} alt="Tiphany sorrindo com o celular na mão" widths={[320, 480]} sizes="55vw" class="aspect-[4/5] w-full object-cover object-top" />
                <figcaption class="absolute inset-x-2.5 bottom-2.5 font-display text-base italic text-tinta/70">bastidor, sempre.</figcaption>
              </figure>
              <div class="pointer-events-none mr-1 mt-6 text-creme" aria-hidden="true"><Carimbo id="carimbo-m" class="relative size-28" /></div>
            </div>
            <Bilhete class="mt-10 rotate-[1.5deg]" />
          </div>
        </div>

        <!-- colagem (tablet e desktop) -->
        <div class="relative mx-auto hidden h-[40rem] w-full max-w-[34rem] [container-type:size] sm:block lg:col-span-6 lg:max-w-none" aria-label="Verdades cruéis demais sobre marketing">
          <!-- fundo vinho -->
          <div class="bolinhas-creme absolute right-0 top-6 h-[82%] w-[78%] rotate-[3deg] bg-vinho" aria-hidden="true"></div>

          <!-- polaroid -->
          <figure class="absolute left-0 top-0 w-[46%] max-w-[15rem] -rotate-[7deg] bg-papel p-3 pb-12 shadow-[0_20px_40px_-18px_rgb(40_0_10/0.5)]" data-reveal>
            <span class="absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 rotate-[4deg] bg-rosa-claro/80" aria-hidden="true"></span>
            <Image src={celular} alt="Tiphany sorrindo com o celular na mão" widths={[320, 480]} sizes="15rem" class="aspect-[4/5] w-full object-cover object-top" />
            <figcaption class="absolute inset-x-3 bottom-3 font-display text-lg italic text-tinta/70">bastidor, sempre.</figcaption>
          </figure>

          <!-- carimbo: vinho sobre o creme, creme sobre o bloco vinho -->
          <div class="pointer-events-none absolute inset-0 text-vinho" aria-hidden="true"><Carimbo id="carimbo-a" /></div>
          <div class="recorte-bloco pointer-events-none absolute inset-0 text-creme" aria-hidden="true"><Carimbo id="carimbo-b" /></div>

          <!-- bilhete -->
          <div class="absolute bottom-6 right-[4%] w-[78%] max-w-[23rem]" data-reveal style="--d:120ms">
            <Bilhete class="rotate-[2deg]" />
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ p.04 CARTA ══════════════ -->
    <section id="carta" class="grao relative overflow-hidden bg-papel pb-24 pt-14 sm:pb-32 sm:pt-20">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
        <!-- cabeçalho da página -->
        <div class="eyebrow grid grid-cols-[1fr_auto_1fr] items-center gap-4 border-b border-tinta/20 pb-4 text-tinta/55">
          <span>p. 04<span class="hidden sm:inline"> — Carta da fundadora</span></span>
          <Logo variante="minusculo" class="w-14 text-vinho" decorativo />
          <span class="text-right">Edição 2026</span>
        </div>

        <div class="mt-16 grid gap-20 lg:mt-20 lg:grid-cols-12 lg:gap-12">
          <!-- foto em arco -->
          <figure class="relative mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none" data-reveal>
            <div class="relative">
              <div class="absolute inset-0 translate-x-4 translate-y-4 rounded-t-full border border-vinho sm:translate-x-6 sm:translate-y-6" aria-hidden="true"></div>
              <Image
                src={carta}
                alt="Tiphany sentada, sorrindo, em ensaio de estúdio"
                widths={[480, 750]}
                sizes="(min-width:1024px) 36vw, 90vw"
                class="relative aspect-[3/4] w-full rounded-t-full object-cover object-[50%_15%]"
              />
              <Lettering class="pointer-events-none absolute -bottom-12 -right-3 z-10 w-[64%] -rotate-[8deg] text-vinho drop-shadow-[0_2px_0_rgb(251_247_242/0.9)] sm:-right-8" aria-hidden="true" />
            </div>
            <figcaption class="mt-20 flex items-baseline justify-between gap-4 border-t border-tinta/15 pt-4">
              <span class="eyebrow text-tinta/50">Fundadora & diretora criativa</span>
              <span class="whitespace-nowrap font-display text-base italic text-tinta/50">ensaio 2025</span>
            </figcaption>
          </figure>

          <!-- carta -->
          <div class="lg:col-span-7 lg:pl-6">
            <blockquote class="display text-[clamp(2.2rem,4.2vw,3.8rem)] italic text-vinho" data-reveal>
              “Marketing de moda não é sobre postar mais. É sobre postar <span class="not-italic text-tinta">com verdade.</span>”
            </blockquote>

            <p class="mt-14 font-display text-3xl italic" data-reveal>Querida marca,</p>
            <div class="mt-6 gap-10 text-[1.05rem] leading-[1.8] text-tinta/80 md:columns-2 [&>p+p]:mt-5" data-reveal>
              <p>
                <span class="float-left mr-3 mt-1.5 font-display text-[4.4rem] leading-[0.75] text-vinho">E</span>u comecei nos bastidores: entre provas de roupa,
                sets de fotografia e coleções que precisavam virar conteúdo para ontem. Foi ali que entendi que o feed é só a vitrine. O que vende é a história por
                trás dela.
              </p>
              <p>
                A True nasceu para contar essa história. A gente planeja, vai para o set, grava, edita e acompanha cada resultado, com ética, cuidado e
                proximidade, como uma extensão do seu time.
              </p>
              <p>Se a sua marca tem algo a dizer, a gente ajuda o mundo a ouvir.</p>
            </div>

            <div class="mt-10 flex flex-wrap items-end justify-between gap-10" data-reveal>
              <div>
                <p class="font-assinatura text-[4.2rem] leading-none text-vinho">Tiphany</p>
                <p class="eyebrow mt-2 text-tinta/50">Com carinho, da redação da True</p>
              </div>
              <dl class="flex gap-8 sm:gap-10">
                {
                  fichaTecnica.map((f) => (
                    <div class="flex flex-col-reverse">
                      <dt class="eyebrow mt-1 text-[0.62rem] text-tinta/50">{f.rotulo}</dt>
                      <dd class="font-display text-4xl text-vinho">{f.valor}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ p.05 SERVIÇOS ══════════════ -->
    <section id="servicos" class="bolinhas-creme relative overflow-hidden bg-vinho pb-24 pt-24 text-creme sm:pb-32 sm:pt-32">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="eyebrow text-rosa-claro" data-reveal>p. 05 — O que fazemos</p>
            <h2 class="display mt-6 text-[clamp(2.8rem,6.4vw,6rem)]" data-reveal>
              Conteúdo estratégico <em class="text-rosa-claro">também vende.</em>
            </h2>
          </div>
          <p class="max-w-xs text-lg leading-relaxed text-creme/75 lg:col-span-4 lg:justify-self-end" data-reveal>
            Escolha o look da sua marca. Cada serviço funciona sozinho ou combinado, como um bom guarda-roupa.
          </p>
        </div>
      </div>

      <!-- arara -->
      <div class="relative mx-auto mt-16 max-w-[90rem] sm:mt-20">
        <div class="pointer-events-none absolute inset-x-5 top-0 hidden h-3 rounded-full bg-linear-to-b from-[#e9dccb] via-[#b9a27c] to-[#7d6a4c] shadow-[0_6px_14px_rgb(20_0_5/0.45)] sm:inset-x-8 lg:block" aria-hidden="true"></div>

        <ol data-carrossel="servicos" class="flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-px-5 px-5 pb-8 pt-6 [scrollbar-width:none] sm:px-8 lg:grid lg:snap-none lg:grid-cols-5 lg:gap-5 lg:overflow-visible lg:pb-0 lg:pt-0">
          {
            servicos.map((s, i) => (
              <li
                class="etiqueta-pendurada group relative w-[78vw] max-w-[19rem] shrink-0 snap-center lg:w-auto lg:max-w-none"
                style={`--cordao:${[2.5, 5, 1.75, 4.25, 3][i]}rem; --giro:${[-2, 1.5, -1, 2.2, -1.6][i]}deg`}
              >
                <!-- cordão -->
                <span class="absolute left-1/2 top-0 hidden h-[calc(var(--cordao)+1.6rem)] w-px -translate-x-1/2 bg-[#d8c7ad] lg:block" aria-hidden="true"></span>

                <article class="etiqueta relative h-full drop-shadow-[0_22px_24px_rgb(20_0_5/0.45)] origin-top transition-transform duration-700 ease-[cubic-bezier(.3,1.6,.5,1)] lg:mt-[var(--cordao)] lg:rotate-(--giro) lg:group-hover:rotate-0">
                  <div class="grao relative flex h-full flex-col bg-papel px-5 pb-6 pt-11 text-tinta [clip-path:polygon(22%_0,78%_0,100%_7%,100%_100%,0_100%,0_7%)]">
                    <span class="absolute left-1/2 top-4 size-3.5 -translate-x-1/2 rounded-full bg-vinho ring-2 ring-[#b9a27c]" aria-hidden="true"></span>
                    <p class="eyebrow flex justify-between text-[0.62rem] text-vinho">
                      <span>Look {String(i + 1).padStart(2, "0")}</span><span class="text-tinta/40">True</span>
                    </p>
                    <div class="mt-4 overflow-hidden">
                      <Image
                        src={s.foto}
                        alt={s.legenda}
                        widths={[320, 480]}
                        sizes="(min-width:1024px) 17vw, 78vw"
                        class="aspect-[4/3] w-full object-cover object-[50%_18%] grayscale-[60%] transition duration-700 group-hover:scale-105 group-hover:grayscale-0"
                      />
                    </div>
                    <h3 class="display mt-5 text-[1.7rem] leading-[1.02] lg:text-[clamp(1.45rem,1.9vw,1.9rem)]">{s.titulo}</h3>
                    <p class="mt-3 text-[0.92rem] leading-relaxed text-tinta/70">{s.texto}</p>
                    <ul class="mt-auto border-t border-dashed border-tinta/25 pt-4 text-[0.68rem] uppercase tracking-[0.18em] text-tinta/55">
                      {s.tags.map((t) => <li class="py-0.5">— {t}</li>)}
                    </ul>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
        <div class="mt-4 flex items-center justify-center gap-5 lg:hidden" data-controles="servicos">
          <button type="button" data-anterior aria-label="Anterior" class="grid size-11 place-items-center rounded-full border border-current/30 transition-colors hover:bg-current/10">←</button>
          <div class="flex items-center gap-2" data-pontos></div>
          <button type="button" data-proximo aria-label="Próximo" class="grid size-11 place-items-center rounded-full border border-current/30 transition-colors hover:bg-current/10">→</button>
        </div>
      </div>

      <div class="mx-auto mt-16 flex max-w-[90rem] flex-col items-start justify-between gap-6 px-5 sm:flex-row sm:items-center sm:px-8 lg:mt-24" data-reveal>
        <p class="font-display text-2xl italic text-creme/90 sm:text-3xl">Não sabe qual vestir? A gente monta o look com você.</p>
        <a href={whatsappLink("Olá! Quero entender qual serviço da True faz mais sentido para a minha marca.")} target="_blank" rel="noopener" class="btn-creme shrink-0">
          Montar meu plano <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- ══════════════ p.06 MÉTODO ══════════════ -->
    <section id="metodo" class="relative overflow-hidden bg-rosa-papel py-24 sm:py-32">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="eyebrow text-vinho" data-reveal>p. 06 — O método em quatro atos</p>
            <h2 class="display mt-6 text-[clamp(2.6rem,5.4vw,5rem)]" data-reveal>
              Não é sobre estar presente. <em class="text-vinho">É sobre ser lembrada.</em>
            </h2>
          </div>
          <p class="max-w-xs text-lg leading-relaxed text-tinta/70 lg:col-span-4 lg:justify-self-end" data-reveal>
            O primeiro mês com a True, do jeito que ele acontece no nosso planner.
          </p>
        </div>

        <!-- planner -->
        <div class="relative mt-16 sm:mt-20" data-reveal>
          <!-- anotações -->
          <div class="pointer-events-none absolute -top-[4.5rem] left-4 z-10 hidden items-end gap-1 text-vinho lg:flex" aria-hidden="true">
            <p class="-rotate-6 font-assinatura text-[2.6rem] leading-none">comece por aqui</p>
            <svg class="mb-[-2.6rem] h-14 w-12" viewBox="0 0 48 56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6c18 4 26 18 22 44" /><path d="M20 42l8 9 6-10" /></svg>
          </div>
          <p class="pointer-events-none absolute -bottom-14 right-6 hidden rotate-[-4deg] font-assinatura text-[2.6rem] leading-none text-vinho lg:block" aria-hidden="true">
            resultado! ♡
          </p>

          <div class="grao relative bg-papel shadow-[0_40px_70px_-35px_rgb(92_3_21/0.55)]">
            <!-- espiral -->
