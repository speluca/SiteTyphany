<script>
  import { contato } from "../data/site";

  // carrosséis (celular/tablet): setas + pontos
  document.querySelectorAll<HTMLElement>("[data-carrossel]").forEach((trilho) => {
    const ctrl = document.querySelector<HTMLElement>(`[data-controles="${trilho.dataset.carrossel}"]`);
    if (!ctrl) return;
    const itens = [...trilho.children] as HTMLElement[];
    const pontos = ctrl.querySelector<HTMLElement>("[data-pontos]")!;
    const botoes = itens.map((_, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.setAttribute("aria-label", `Ir para o item ${i + 1}`);
      b.className = "h-2 w-2 rounded-full bg-current opacity-30 transition-all duration-300";
      b.addEventListener("click", () => ir(i));
      pontos.append(b);
      return b;
    });
    let atual = 0;
    const ir = (i: number) => {
      const alvo = itens[Math.max(0, Math.min(itens.length - 1, i))];
      trilho.scrollTo({ left: alvo.offsetLeft - (trilho.clientWidth - alvo.clientWidth) / 2, behavior: "smooth" });
    };
    const marcar = () => {
      const centro = trilho.scrollLeft + trilho.clientWidth / 2;
      let melhor = 0, dist = Infinity;
      itens.forEach((el, i) => {
        const d = Math.abs(el.offsetLeft + el.clientWidth / 2 - centro);
        if (d < dist) { dist = d; melhor = i; }
      });
      atual = melhor;
      botoes.forEach((b, i) => {
        b.classList.toggle("opacity-100", i === atual);
        b.classList.toggle("w-6", i === atual);
        b.classList.toggle("opacity-30", i !== atual);
      });
    };
    ctrl.querySelector("[data-anterior]")!.addEventListener("click", () => ir(atual - 1));
    ctrl.querySelector("[data-proximo]")!.addEventListener("click", () => ir(atual + 1));
    trilho.addEventListener("scroll", () => requestAnimationFrame(marcar), { passive: true });
    marcar();
  });

  // formulário → capa ao vivo + WhatsApp
  const form = document.getElementById("form-contato") as HTMLFormElement;
  const erro = form.querySelector<HTMLElement>("[data-erro]")!;
  const capaMarca = document.querySelector<HTMLElement>("[data-capa-marca]")!;
  const capaServico = document.querySelector<HTMLElement>("[data-capa-servico]")!;
  const capaNome = document.querySelector<HTMLElement>("[data-capa-nome]")!;
  const valor = (n: string) => String(new FormData(form).get(n) ?? "").trim();

  const atualizarCapa = () => {
    capaMarca.textContent = valor("marca") || "Sua Marca";
    const sv = valor("servico");
    capaServico.textContent = sv === "Ainda não sei" ? "a estratégia certa" : sv.toLowerCase();
    capaNome.textContent = valor("nome") || "você";
  };
  form.addEventListener("input", atualizarCapa);
  form.addEventListener("change", atualizarCapa);

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const nome = valor("nome");
    if (!nome) {
      erro.hidden = false;
      form.querySelector<HTMLInputElement>("[name=nome]")?.focus();
      return;
    }
    erro.hidden = true;
    const marca = valor("marca");
    const texto = [
      `Olá, True Marketing! Meu nome é ${nome}${marca ? ` (${marca})` : ""}.`,
      `Quero ser capa! Tenho interesse em: ${valor("servico")}.`,
      valor("mensagem"),
    ]
      .filter(Boolean)
      .join("\n");
    window.open(`https://wa.me/${contato.whatsappNumero}?text=${encodeURIComponent(texto)}`, "_blank", "noopener");
  });
</script>
